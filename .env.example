# Copy this file to a new file named .env and put your real key there.
# .env is in .gitignore, so it never gets uploaded to GitHub.

# Your free key from https://aistudio.google.com  (click "Get API key")
GEMINI_API_KEY=paste-your-key-here

# Which Gemini model the agent uses. Run "python src/check_setup.py"
# to see which models your key can use, and change this if needed.
AGENT_MODEL=gemini-flash-lite-latest
